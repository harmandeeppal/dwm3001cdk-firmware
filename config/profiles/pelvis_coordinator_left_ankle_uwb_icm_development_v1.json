{
  "schema_version": 1,
  "profile_id": "pelvis_coordinator_left_ankle_uwb_icm_development_v1",
  "enabled": false,
  "description": "Development profile: DWM-02-PELVIS is the laptop-connected UWB coordinator and sends its external ICM-20948 telemetry at 60 Hz. DWM-05-LEFT-ANKLE is the responder and also sends 60 Hz ICM-20948 telemetry.",
  "role_assignments": {
    "initiator": "DWM-02",
    "responder": "DWM-05"
  },
  "connection_policy": {
    "laptop_connected_device": "DWM-02",
    "standalone_powered_device": "DWM-05",
    "discover_by": "jlink_serial",
    "serial_baud": 115200
  },
  "telemetry": {
    "imu_rate_hz": 60,
    "imu_i2c_address": "0x69",
    "imu_modalities": ["accelerometer", "gyroscope"],
    "magnetometer_policy": "disabled_not_initialized_not_read_not_transmitted",
    "format": "COBS type 0x03 raw six-axis ICM-20948 samples with UWB type 0x01 distance records on PELVIS"
  },
  "uwb": {
    "channel": 5,
    "data_rate": "6.8_Mbps",
    "preamble_symbols": 128,
    "response_delay_uus": 1000,
    "antenna_delay": {
      "DWM-05": { "tx": 16378, "rx": 16378 },
      "DWM-02": { "tx": 16378, "rx": 16378 }
    },
    "calibration_status": "historical_pair_setting_loaded_for_development; revalidation_required_after_final_body_mounting"
  }
}
